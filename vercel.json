{
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/app.html" }],
  "headers": [
    { "source": "/(admin|auth|apply|payment|portal|certificate|style-guide)(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
